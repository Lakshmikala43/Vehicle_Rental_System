{
  "name": "rentride-vehicle-rental-fleet-system",
  "version": "1.0.0",
  "description": "RentRide - Enterprise Vehicle Rental & Fleet Management System",
  "main": "frontend/js/app.js",
  "scripts": {
    "start": "python -m http.server 3000 --directory frontend",
    "build": "cd backend && mvn clean package -DskipTests",
